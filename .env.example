# Fractal Neural Simulation Engine (FNSE) - Environment Configuration
# Copy this file to .env and fill in your API keys
# =============================================================================
# Model Routing (LiteLLM)
# =============================================================================
# Default LLM model for agents (OpenAI, Anthropic, Google, Cohere, Together, etc.)
DEFAULT_MODEL=gpt-4o-mini
# Model provider (openai, anthropic, google, cohere, together, azure, etc.)
MODEL_PROVIDER=openai
# Sampling temperature (0.0 = deterministic, 2.0 = creative)
MODEL_TEMPERATURE=0.7
# Maximum tokens per completion
MAX_TOKENS=2048

# LiteLLM specific settings
# Fallback models in order of preference (JSON array string)
LITELLM_FALLBACK_MODELS=["gpt-3.5-turbo", "claude-3-haiku-20240307"]
# Request timeout in seconds
LITELLM_REQUEST_TIMEOUT=60
# Max retries for failed requests
LITELLM_MAX_RETRIES=3
# Number of retries (alias)
LITELLM_NUM_RETRIES=3

# =============================================================================
# API Keys (Required for LLM providers)
# Get your keys from the respective provider dashboards
# =============================================================================
# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic - https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google AI - https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Cohere - https://dashboard.cohere.ai/api-keys
COHERE_API_KEY=your-cohere-api-key-here

# Together AI - https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=your-together-api-key-here

# Azure OpenAI (if using Azure)
# AZURE_API_KEY=your-azure-api-key-here
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-02-01

# =============================================================================
# Redis (Optional - for state persistence, checkpoints, caching)
# =============================================================================
# Redis connection URL (use redis://redis:6379/0 in Docker)
REDIS_URL=redis://localhost:6379/0
# Prefix for all Redis keys
REDIS_KEY_PREFIX=fnse:
# Default TTL for cached states (seconds)
REDIS_TTL=3600

# =============================================================================
# Simulation Configuration
# =============================================================================
# Maximum agents per simulation
MAX_AGENTS=100
# Maximum ticks per simulation epoch
MAX_TICKS_PER_EPOCH=1000
# Timeout per tick (seconds)
TICK_TIMEOUT_SECONDS=30.0
# Convergence threshold for global loss
GLOBAL_LOSS_THRESHOLD=0.01
# Checkpoint every N ticks
CHECKPOINT_INTERVAL=10

# =============================================================================
# Safety Thresholds
# =============================================================================
# Max allowed divergence before circuit break
MAX_DIVERGENCE_SCORE=10.0
# Max serialized state size per agent (bytes)
MAX_STATE_SIZE_BYTES=1000000
# Max recursive skill compilation depth
MAX_RECURSION_DEPTH=10

# =============================================================================
# API Server Configuration
# =============================================================================
# FastAPI host
API_HOST=0.0.0.0
# FastAPI port
API_PORT=8000
# Number of uvicorn workers
API_WORKERS=1

# =============================================================================
# Logging Configuration
# =============================================================================
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Log format (json or text)
LOG_FORMAT=json

# =============================================================================
# Worker Configuration (for docker-compose worker service)
# =============================================================================
# Enable worker mode
WORKER_MODE=false